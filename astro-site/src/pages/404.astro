---
import Base from '../layouts/Base.astro';
import '../styles/not-found.css';
---
<Base
  title="Page Not Found — ElectraSim"
  description="The page you're looking for doesn't exist. Return to the ElectraSim homepage."
  canonical="https://electrasim.com/404/"
  robots="noindex, follow"
  contentSecurityPolicy="default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
>
  <main id="main-content">
    <div class="not-found" data-live>
      <div class="not-found-inner">
        <span class="not-found-code" aria-hidden="true">404</span>
        <h1>Page Not Found</h1>
        <p>The page you're looking for has been moved, deleted, or never existed. Let's get you back on track.</p>
        <div class="not-found-actions">
          <a href="/" class="btn-primary">← Back to Home</a>
          <a href="/blog/" class="btn-secondary">Browse the Blog</a>
        </div>
      </div>
    </div>
  </main>
</Base>
