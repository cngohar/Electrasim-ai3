---
import '../styles/global.css';
import packageMetadata from '../../../package.json';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string[];
  robots?: string;
  contentSecurityPolicy?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  keywords = [],
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
  contentSecurityPolicy,
  ogImage = 'https://electrasim.com/og-image.png',
  ogType = 'website',
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  {contentSecurityPolicy && <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />}
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#2563eb" />
  <script is:inline src={`/js/theme.js?v=${packageMetadata.version}`}></script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
  <meta name="author" content="ElectraSim" />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="google-site-verification" content="OjfkIUfSKhmhu6iuwXIaBisuhtpoTxAZgx35acQko2I" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="ElectraSim Electrical Toolbox" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@electrasim" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/pwa-192.svg" />

  <!-- Display & Body Fonts Preloads -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />

  <!-- Structured Data JSON-LD Graph -->
  {structuredData && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body class="tool-app-body">
  <slot />
</body>
</html>

<style is:global>
  .tool-app-body {
    overflow-x: hidden;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background: var(--bg);
  }
</style>
