---
import Icon from '../Icon.astro';

interface Props {
  heading: string;
  description: string;
  button: string;
}

const { heading, description, button } = Astro.props;
---

<section class="cta-section" data-live>
  <span class="cta-bus" aria-hidden="true"><span class="pulse-x"></span></span>
  <div class="wrap">
    <h2 class="cta-title">{heading}</h2>
    <p class="cta-desc">{description}</p>
    <a href="/app/" class="btn-cta">
      <Icon name="bolt" size={19} stroke={2.4} />
      {button}
    </a>
  </div>
</section>
