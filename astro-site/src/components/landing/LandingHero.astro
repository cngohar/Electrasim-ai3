---
interface Props {
  badge: string;
  heading: string;
  highlight: string;
  description: string;
  primaryCta: string;
  secondaryCta: string;
  trustItems: string[];
}

const { badge, heading, highlight, description, primaryCta, secondaryCta, trustItems } =
  Astro.props;
---

<header class="hero" role="banner">
  <div class="wrap">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-dot" aria-hidden="true"></span>
      {badge}
    </div>
    <h1>{heading}<br />{' '}<span class="accent">{highlight}</span></h1>
    <p class="hero-desc">{description}</p>
    <div class="cta-row">
      <a href="/app/" class="btn-primary">{primaryCta}</a>
      <a href="#how-it-works" class="btn-outline">{secondaryCta}</a>
    </div>
    <div class="trust">
      {trustItems.map((item) => (
        <span class="trust-item"><span class="trust-dot" aria-hidden="true"></span>{item}</span>
      ))}
    </div>
    <div class="hero-frame">
      <picture>
        <source
          type="image/avif"
          srcset="/images/electrasim-simulator-480.avif 480w, /images/electrasim-simulator-800.avif 800w, /images/electrasim-simulator-1200.avif 1200w"
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 960px) calc(100vw - 3rem), 900px"
        />
        <source
          type="image/webp"
          srcset="/images/electrasim-simulator-480.webp 480w, /images/electrasim-simulator-800.webp 800w, /images/electrasim-simulator-1200.webp 1200w"
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 960px) calc(100vw - 3rem), 900px"
        />
        <img
          src="/images/electrasim-simulator-1200.webp"
          srcset="/images/electrasim-simulator-480.webp 480w, /images/electrasim-simulator-800.webp 800w, /images/electrasim-simulator-1200.webp 1200w"
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 960px) calc(100vw - 3rem), 900px"
          alt="ElectraSim circuit simulator showing MCB breaker, bulb, fan and socket connected on the canvas"
          width="1200"
          height="750"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
</header>

<div class="stats-strip" aria-label="Key facts">
  <div class="wrap">
    <div class="stats-grid">
      <div><span class="stat-num">100%</span><span class="stat-label">Free Forever</span></div>
      <div><span class="stat-num">0</span><span class="stat-label">Sign-ups Required</span></div>
      <div><span class="stat-num">16+</span><span class="stat-label">Component Types</span></div>
      <div><span class="stat-num">60fps</span><span class="stat-label">Live Simulation</span></div>
    </div>
  </div>
</div>
