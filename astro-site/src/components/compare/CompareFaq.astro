---
import type { ComparisonFaq } from '../../lib/compare';

interface Props {
  faqs: ComparisonFaq[];
}

const { faqs } = Astro.props;
---

<div class="compare-faq-list">
  {faqs.map((faq, index) => (
    <details class="compare-faq-item" open={index === 0}>
      <summary>{faq.question}</summary>
      <p>{faq.answer}</p>
    </details>
  ))}
</div>
