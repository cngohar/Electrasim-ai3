---
import type { TaskFit } from '../../lib/compare';

interface Props {
  items: TaskFit[];
}

const { items } = Astro.props;
---

<div class="task-fit-list">
  {items.map((item, index) => (
    <article class="task-fit-item">
      <span class="task-fit-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div>
        <h3>{item.task}</h3>
        <p><strong>{item.tool}</strong> - {item.reason}</p>
      </div>
    </article>
  ))}
</div>
