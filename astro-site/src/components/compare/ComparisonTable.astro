---
import type { ComparisonTool } from '../../lib/compare';
import { comparisonReviewedLabel } from '../../lib/compare';

interface Props {
  tools: ComparisonTool[];
}

const { tools } = Astro.props;
---

<p class="scroll-hint" aria-hidden="true">Swipe the table sideways for the full comparison &rarr;</p>
<div
  class="comparison-table-region"
  role="region"
  aria-label="Online circuit simulator comparison"
  tabindex="0"
>
  <table class="comparison-table">
    <caption>
      Product information checked against official sources on {comparisonReviewedLabel}. Prices and
      access terms can change.
    </caption>
    <thead>
      <tr>
        <th scope="col">Tool</th>
        <th scope="col">Best fit</th>
        <th scope="col">Access</th>
        <th scope="col">Price and account</th>
        <th scope="col">Practical wiring fit</th>
        <th scope="col">Save, share and export</th>
      </tr>
    </thead>
    <tbody>
      {tools.map((tool) => (
        <tr class:list={{ 'comparison-table-featured': tool.id === 'electrasim' }}>
          <th scope="row">
            <a href={`#${tool.id}`}>{tool.name}</a>
            {tool.id === 'electrasim' && <span class="comparison-table-owner">This site</span>}
          </th>
          <td>{tool.bestFor}</td>
          <td>{tool.access}</td>
          <td>{tool.priceAndAccount}</td>
          <td>{tool.practicalWiring}</td>
          <td>{tool.sharing}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
