---
import { comparisonReviewedIso, comparisonReviewedLabel } from '../../lib/compare';
---

<header class="compare-hero" data-live>
  <div class="wrap">
    <nav class="compare-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Compare</span>
    </nav>

    <div class="compare-hero-copy">
      <p class="compare-overline">Official-source comparison</p>
      <h1>ElectraSim vs Popular Online Circuit Simulators</h1>
      <p class="compare-hero-lead">
        Circuit simulators are built for different jobs. This comparison shows where ElectraSim,
        CircuitLab, Tinkercad Circuits, EveryCircuit, Falstad and DCACLab fit, so you can choose by
        the work you want to learn.
      </p>
      <div class="compare-hero-actions">
        <a class="btn-primary" href="/app/">Open ElectraSim</a>
        <a class="btn-outline" href="#quick-comparison">View the comparison</a>
      </div>
      <p class="compare-review-note">
        <strong>Research reviewed:</strong>
        <time datetime={comparisonReviewedIso}>{comparisonReviewedLabel}</time>. This page is
        published by ElectraSim and links to each provider's official information.
      </p>
    </div>

    <figure class="compare-product-shot">
      <picture>
        <source
          type="image/avif"
          srcset="/images/electrasim-simulator-480.avif 480w, /images/electrasim-simulator-800.avif 800w, /images/electrasim-simulator-1200.avif 1200w"
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 960px) calc(100vw - 3rem), 1040px"
        />
        <source
          type="image/webp"
          srcset="/images/electrasim-simulator-480.webp 480w, /images/electrasim-simulator-800.webp 800w, /images/electrasim-simulator-1200.webp 1200w"
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 960px) calc(100vw - 3rem), 1040px"
        />
        <img
          src="/images/electrasim-simulator-1200.webp"
          width="1200"
          height="750"
          alt="ElectraSim editor showing connected switches, lights, sockets and protection devices on the circuit canvas"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <figcaption>
        The current ElectraSim editor, captured in v1.6 with a practical wiring circuit open.
      </figcaption>
    </figure>
  </div>
</header>
