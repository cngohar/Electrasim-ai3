---
import type { ComparisonTool } from '../../lib/compare';

interface Props {
  tools: ComparisonTool[];
  compact?: boolean;
}

const { tools, compact = false } = Astro.props;
---

<div class:list={['tool-profile-list', { 'tool-profile-list-compact': compact }]}>
  {tools.map((tool) => (
    <article class="tool-profile" id={tool.id}>
      <div class="tool-profile-heading">
        <p>{tool.bestFor}</p>
        <h3>{compact || tool.id === 'electrasim' ? tool.name : `ElectraSim vs ${tool.name}`}</h3>
        <a href={tool.officialUrl} rel="external">Visit official product page</a>
      </div>

      <div class="tool-profile-copy">
        <p class="tool-profile-strength">{tool.strength}</p>
        <dl>
          <div>
            <dt>Access</dt>
            <dd>{tool.access}</dd>
          </div>
          <div>
            <dt>Price and account</dt>
            <dd>{tool.priceAndAccount}</dd>
          </div>
          <div>
            <dt>Scope note</dt>
            <dd>{tool.boundary}</dd>
          </div>
        </dl>
        <div class="tool-profile-sources" aria-label={`${tool.name} official sources`}>
          <span>Official sources:</span>
          {tool.sources.map((source) => (
            <a href={source.url} rel="external">{source.label}</a>
          ))}
        </div>
      </div>
    </article>
  ))}
</div>
