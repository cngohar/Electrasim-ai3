---
import { TOOLS, getTool } from '../../lib/tools/registry';

interface Props {
  toolId: string;
}
const { toolId } = Astro.props;
const tool = getTool(toolId);
const available = TOOLS.filter((t) => t.status === 'available');
---

<header class="tool-header">
  <button
    class="tool-icon-btn"
    type="button"
    data-drawer-open
    aria-label="Open Electrical Toolbox menu"
    aria-expanded="false"
    aria-controls="toolbox-drawer"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M3 6h18M3 12h18M3 18h18" />
    </svg>
  </button>

  <a class="tool-brand" href="/tools/">
    <span class="tool-brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
      </svg>
    </span>
    <span class="tool-brand-text">
      <span class="tool-brand-name">ElectraSim</span>
      <span class="tool-brand-sub">Electrical Toolbox</span>
    </span>
  </a>

  {tool && (
    <h1 class="tool-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
      </svg>
      {tool.name}
    </h1>
  )}

  <div class="tool-header-actions">
    <button class="tool-icon-btn" type="button" data-palette-open aria-label="Search tools and commands">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
      </svg>
      <span class="tool-kbd">Shift + Space</span>
    </button>

    <button class="tool-icon-btn" type="button" data-theme-toggle aria-label="Switch appearance" aria-pressed="false">
      <span class="theme-icon theme-icon-moon" aria-hidden="true">&#9790;</span>
      <span class="theme-icon theme-icon-sun" aria-hidden="true">&#9728;</span>
      <span class="hide-sm" data-theme-label>Dark Mode</span>
    </button>

    <button class="tool-icon-btn" type="button" data-modal-open="help" data-help-link aria-label="Help and how this works">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.3M12 17h.01" />
      </svg>
      <span class="hide-sm">Help</span>
    </button>

    <button class="tool-icon-btn" type="button" data-fullscreen aria-label="Toggle fullscreen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9V4h5M21 9V4h-5M3 15v5h5M21 15v5h-5" />
      </svg>
    </button>
  </div>
</header>
<span hidden data-available-count={available.length}></span>
