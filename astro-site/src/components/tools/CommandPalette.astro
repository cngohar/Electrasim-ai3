---
/**
 * Command palette (master plan §4). Shift+Space or the header search button.
 * Items are generated from the tool registry so future tools appear here with
 * no changes to this component (§28).
 */
interface Props {
  toolId: string;
}
const { toolId } = Astro.props;
---

<div
  class="tool-palette"
  data-palette
  data-current-tool={toolId}
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Search tools and commands"
>
  <input
    class="tool-palette-input"
    type="text"
    data-palette-input
    placeholder="Search tools or commands…"
    autocomplete="off"
    spellcheck="false"
    aria-controls="palette-list"
    aria-autocomplete="list"
  />
  <ul class="tool-palette-list" id="palette-list" data-palette-list role="listbox" aria-label="Results"></ul>
  <div class="tool-palette-foot">
    <span>↑ ↓ navigate</span><span>↵ open</span><span>esc close</span>
  </div>
</div>
