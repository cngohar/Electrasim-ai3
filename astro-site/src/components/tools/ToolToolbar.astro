---
/**
 * Generic view-toggle bar for any Toolbox tool.
 *
 * Each toggle flips `data-view-<id>` on the workspace root and persists to
 * localStorage, so CSS and tool scripts can react with a plain attribute
 * selector. A future tool declares its own toggles and gets the same bar.
 */
export interface ViewToggle {
  id: string;
  label: string;
  /** Key in the shared icon map below. */
  icon: 'play' | 'eye' | 'list' | 'grid';
  /** Default on/off when the visitor has no stored preference. */
  on?: boolean;
  /** Show a live status pip (used by "Animate"). */
  pip?: boolean;
}

interface Props {
  toggles: ViewToggle[];
}
const { toggles } = Astro.props;

const ICONS: Record<string, string> = {
  play: '<path d="M7 4.5 19 12 7 19.5z" fill="currentColor" stroke="none"></path>',
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"></path><circle cx="12" cy="12" r="3"></circle>',
  list: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect>',
};
---

<div class="tool-toolbar" data-toolbar role="group" aria-label="View options">
  {toggles.map((t, i) => (
    <>
      {i > 0 && <span class="tool-toolbar-sep" aria-hidden="true"></span>}
      <button
        class="tool-toolbar-btn"
        type="button"
        data-view-toggle={t.id}
        data-default={String(t.on !== false)}
        aria-pressed={String(t.on !== false)}
        title={t.label}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[t.icon]} />
        <span>{t.label}</span>
        {t.pip && <span class="tool-toolbar-pip" aria-hidden="true"></span>}
      </button>
    </>
  ))}
</div>
