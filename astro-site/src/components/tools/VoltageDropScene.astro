---
// VoltageDropScene.astro - Pure SVG Interactive Physics Scenery
---

<div id="scene-container" class="scene-container">
  <div id="scene-scaler" class="scene-scaler">
    <div id="scene-perspective-wrapper" class="scene-perspective-wrapper">
      <svg
        id="voltage-drop-svg"
        viewBox="0 0 1440 810"
        width="1440"
        height="810"
        class="scene-svg"
        aria-label="Interactive electrical scenery illustrating voltage drop from source to load across a cable"
      >
        <defs>
          <!-- Sky Gradients -->
          <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#55b5f0" class="sky-stop-0" />
            <stop offset="52%" stop-color="#a8dcf8" class="sky-stop-52" />
            <stop offset="100%" stop-color="#eefaff" class="sky-stop-100" />
          </linearGradient>

          <radialGradient id="sunAura" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#fff7cf" stop-opacity="0.7" class="sun-stop-0" />
            <stop offset="50%" stop-color="#fff1a8" stop-opacity="0.22" class="sun-stop-50" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
          </radialGradient>

          <linearGradient id="horizonGlow" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.62" class="horizon-stop" />
          </linearGradient>

          <!-- Mountain & Hill Gradients -->
          <linearGradient id="mountainFar" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#88afc6" class="mt-far-0" />
            <stop offset="100%" stop-color="#b8d2d4" class="mt-far-100" />
          </linearGradient>

          <linearGradient id="mountainNear" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#7da9a5" class="mt-near-0" />
            <stop offset="100%" stop-color="#a7c7af" class="mt-near-100" />
          </linearGradient>

          <linearGradient id="farHillGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#b4d5b9" />
            <stop offset="100%" stop-color="#82ad82" />
          </linearGradient>

          <linearGradient id="midHillGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#92c97b" />
            <stop offset="100%" stop-color="#67a45a" />
          </linearGradient>

          <linearGradient id="grassGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#78bb5e" />
            <stop offset="55%" stop-color="#559a45" />
            <stop offset="100%" stop-color="#347a36" />
          </linearGradient>

          <linearGradient id="pathGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#e9d9aa" />
            <stop offset="100%" stop-color="#cbb27b" />
          </linearGradient>

          <linearGradient id="cloudFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="100%" stop-color="#e5f1f8" />
          </linearGradient>

          <linearGradient id="poleGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#8a929c" />
            <stop offset="50%" stop-color="#6b737e" />
            <stop offset="100%" stop-color="#525a64" />
          </linearGradient>

          <linearGradient id="boxGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#b3b9c1" />
            <stop offset="100%" stop-color="#7b838e" />
          </linearGradient>

          <linearGradient id="doorGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#9aa1ab" />
            <stop offset="100%" stop-color="#818994" />
          </linearGradient>

          <!-- Filters -->
          <filter id="cloudBlur" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="7" />
          </filter>
          <filter id="cloudSoft" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="2.5" />
          </filter>
          <filter id="glowGreen" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter id="glowThermal" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- SKY BACKGROUND -->
        <rect width="1440" height="810" fill="url(#skyGrad)" />

        <!-- NIGHT STARS (Active when dark mode) -->
        <g class="stars-group" aria-hidden="true">
          <circle cx="120" cy="80" r="1.2" fill="#ffffff" class="star" style="animation-delay: 0.2s;" />
          <circle cx="280" cy="140" r="1.5" fill="#ffffff" class="star" style="animation-delay: 1.1s;" />
          <circle cx="450" cy="65" r="1" fill="#ffffff" class="star" style="animation-delay: 0.7s;" />
          <circle cx="620" cy="110" r="1.8" fill="#ffffff" class="star" style="animation-delay: 1.8s;" />
          <circle cx="780" cy="70" r="1.2" fill="#ffffff" class="star" style="animation-delay: 0.5s;" />
          <circle cx="950" cy="130" r="1.5" fill="#ffffff" class="star" style="animation-delay: 2.2s;" />
          <circle cx="1120" cy="85" r="1.1" fill="#ffffff" class="star" style="animation-delay: 1.4s;" />
          <circle cx="1300" cy="105" r="1.6" fill="#ffffff" class="star" style="animation-delay: 0.9s;" />
        </g>

        <!-- SUN / MOON AURA -->
        <circle cx="460" cy="170" r="220" fill="url(#sunAura)" aria-hidden="true" />
        <rect y="260" width="1440" height="250" fill="url(#horizonGlow)" aria-hidden="true" />

        <!-- CLOUDS -->
        <g class="clouds-group" aria-hidden="true">
          <!-- Cloud 1 -->
          <g class="cloud" style="animation-duration: 48s; animation-delay: 0s;">
            <g transform="translate(0, 80) scale(0.95)" opacity="0.95">
              <ellipse cx="4" cy="15" rx="91" ry="19" fill="#477da4" opacity="0.13" filter="url(#cloudBlur)" />
              <g filter="url(#cloudSoft)" fill="url(#cloudFill)">
                <ellipse cx="0" cy="0" rx="70" ry="26" />
                <ellipse cx="45" cy="-14" rx="52" ry="22" />
                <ellipse cx="-48" cy="-8" rx="44" ry="18" />
                <ellipse cx="12" cy="-26" rx="40" ry="20" />
              </g>
              <ellipse cx="2" cy="-14" rx="56" ry="21" fill="#ffffff" opacity="0.2" />
            </g>
          </g>
          <!-- Cloud 2 -->
          <g class="cloud" style="animation-duration: 62s; animation-delay: -18s;">
            <g transform="translate(0, 140) scale(1.1)" opacity="0.9">
              <ellipse cx="4" cy="15" rx="91" ry="19" fill="#477da4" opacity="0.13" filter="url(#cloudBlur)" />
              <g filter="url(#cloudSoft)" fill="url(#cloudFill)">
                <ellipse cx="0" cy="0" rx="70" ry="26" />
                <ellipse cx="45" cy="-14" rx="52" ry="22" />
                <ellipse cx="-48" cy="-8" rx="44" ry="18" />
                <ellipse cx="12" cy="-26" rx="40" ry="20" />
              </g>
            </g>
          </g>
          <!-- Cloud 3 -->
          <g class="cloud" style="animation-duration: 54s; animation-delay: -32s;">
            <g transform="translate(0, 95) scale(0.75)" opacity="0.85">
              <g filter="url(#cloudSoft)" fill="url(#cloudFill)">
                <ellipse cx="0" cy="0" rx="70" ry="26" />
                <ellipse cx="45" cy="-14" rx="52" ry="22" />
                <ellipse cx="-48" cy="-8" rx="44" ry="18" />
              </g>
            </g>
          </g>
        </g>

        <!-- BIRDS -->
        <g class="birds-group" aria-hidden="true">
          <g transform="translate(540, 160) scale(0.9)" opacity="0.45">
            <g class="bird" style="animation-delay: 0.2s;">
              <path d="M-18 2 Q-10 -7 0 1 Q10 -7 18 2" fill="none" stroke="#35566f" stroke-width="2.4" stroke-linecap="round" />
            </g>
          </g>
          <g transform="translate(580, 145) scale(0.75)" opacity="0.4">
            <g class="bird" style="animation-delay: 0.8s;">
              <path d="M-18 2 Q-10 -7 0 1 Q10 -7 18 2" fill="none" stroke="#35566f" stroke-width="2.4" stroke-linecap="round" />
            </g>
          </g>
          <g transform="translate(615, 170) scale(0.65)" opacity="0.35">
            <g class="bird" style="animation-delay: 1.4s;">
              <path d="M-18 2 Q-10 -7 0 1 Q10 -7 18 2" fill="none" stroke="#35566f" stroke-width="2.4" stroke-linecap="round" />
            </g>
          </g>
        </g>

        <!-- DISTANT MOUNTAINS -->
        <path d="M-40 430 L110 320 L280 390 L460 300 L620 375 L820 285 L990 380 L1160 310 L1340 370 L1480 305 L1500 500 L-40 500 Z" fill="url(#mountainFar)" />
        <path d="M-40 450 L160 360 L350 420 L530 350 L710 415 L910 340 L1080 405 L1270 345 L1480 410 L1500 550 L-40 550 Z" fill="url(#mountainNear)" opacity="0.9" />

        <!-- ROLLING HILLS -->
        <path d="M-60 480 Q220 380 520 440 T1100 430 T1500 460 L1500 680 L-60 680 Z" fill="url(#farHillGrad)" />
        <path d="M-60 520 Q300 440 680 490 T1500 480 L1500 750 L-60 750 Z" fill="url(#midHillGrad)" />

        <!-- BACKGROUND TREES (Grounded & Swaying at base) -->
        <g transform="translate(180, 480) scale(0.65)" class="tree-bg" aria-hidden="true">
          <ellipse cx="0" cy="2" rx="28" ry="6" fill="#1f5d32" opacity="0.16" />
          <g class="tree" style="animation-duration: 5.5s; animation-delay: 0.4s;">
            <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#4a7a46" />
            <circle cx="0" cy="-42" r="24" fill="#4f8a4b" />
            <circle cx="-16" cy="-32" r="16" fill="#467d45" />
            <circle cx="15" cy="-33" r="15" fill="#467d45" />
          </g>
        </g>
        <g transform="translate(340, 500) scale(0.75)" class="tree-bg" aria-hidden="true">
          <ellipse cx="0" cy="2" rx="28" ry="6" fill="#1f5d32" opacity="0.16" />
          <g class="tree" style="animation-duration: 6s; animation-delay: 1.2s;">
            <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#4a7a46" />
            <circle cx="0" cy="-42" r="24" fill="#4f8a4b" />
            <circle cx="-16" cy="-32" r="16" fill="#467d45" />
            <circle cx="15" cy="-33" r="15" fill="#467d45" />
          </g>
        </g>

        <!-- FOREGROUND GRASS & WINDING PATHWAY -->
        <path d="M-60 560 Q260 500 640 550 T1500 540 L1500 850 L-60 850 Z" fill="url(#grassGrad)" />
        <path d="M520 810 C620 730, 680 660, 720 620 C760 580, 840 560, 960 550 C1060 542, 1070 545, 1080 548 L1040 560 C930 570, 840 600, 780 650 C710 710, 640 760, 580 810 Z" fill="url(#pathGrad)" opacity="0.95" />

        <!-- FOREGROUND TREES (LEFT - Grounded & Swaying at trunk base) -->
        <g transform="translate(120, 610) scale(1.15)" aria-hidden="true">
          <ellipse cx="0" cy="2" rx="28" ry="6" fill="#1f5d32" opacity="0.25" />
          <g class="tree" style="animation-duration: 4.8s; animation-delay: 0.1s;">
            <rect x="-4" y="-30" width="8" height="30" rx="2" fill="#6d4f37" />
            <path d="M0 -27 L-11 -40 M0 -34 L12 -45" stroke="#65462f" stroke-width="3" stroke-linecap="round" />
            <circle cx="0" cy="-42" r="24" fill="#3f8a3f" />
            <circle cx="-16" cy="-32" r="16" fill="#37803a" />
            <circle cx="15" cy="-33" r="15" fill="#37803a" />
            <circle cx="-6" cy="-49" r="12" fill="#57a54e" opacity="0.88" />
          </g>
        </g>

        <!-- SOURCE ELECTRICAL CABINET (LEFT) -->
        <!-- Placed at x=320, y=480. Cabinet spans x=290 to x=510, y=320 to y=550 -->
        <g id="source-structure" transform="translate(320, 480)">
          <!-- Ground Shadow -->
          <ellipse cx="80" cy="180" rx="90" ry="18" fill="#1b4d29" opacity="0.4" />

          <!-- Concrete Pillar / Mounting Post -->
          <rect x="55" y="60" width="46" height="120" rx="4" fill="url(#poleGrad)" stroke="#434a52" stroke-width="2" />
          <rect x="42" y="170" width="72" height="16" rx="3" fill="#606872" stroke="#373d44" stroke-width="2" />

          <!-- Main Enclosure (Width 220, from x=-30 to x=190 -> Canvas X 290 to 510) -->
          <rect x="-30" y="-160" width="220" height="230" rx="14" fill="url(#boxGrad)" stroke="#535a63" stroke-width="3" />
          <!-- Enclosure Bevel Shadow -->
          <rect x="-24" y="-154" width="208" height="218" rx="10" fill="none" stroke="#ffffff" stroke-width="1.5" opacity="0.4" />

          <!-- Cabinet Door -->
          <rect x="-15" y="-145" width="190" height="200" rx="8" fill="url(#doorGrad)" stroke="#4a5059" stroke-width="2" />

          <!-- Hazard Warning Triangle (⚡) -->
          <g transform="translate(80, -50)">
            <polygon points="0,-42 -36,24 36,24" fill="#facc15" stroke="#1e293b" stroke-width="3.5" stroke-linejoin="round" />
            <path d="M2 -30 L-14 -2 L-2 -2 L-6 16 L12 -8 L0 -8 Z" fill="#0f172a" />
          </g>

          <!-- Status Indicator LED -->
          <g id="source-status-led" transform="translate(5, -125)">
            <circle cx="0" cy="0" r="9" fill="#1e293b" />
            <circle cx="0" cy="0" r="6" fill="#22c55e" id="source-led-bulb" class="led-blink" filter="url(#glowGreen)" />
          </g>

          <!-- Main Isolator Handle -->
          <rect x="135" y="-60" width="18" height="42" rx="4" fill="#1e293b" />
          <rect x="138" y="-45" width="12" height="18" rx="2" fill="#ef4444" />

          <!-- High-Voltage Output Weatherhead / Gland (Right Wall: Canvas X 510, Y 395) -->
          <!-- x=190, y=-85 relative to transform(320, 480) -> global (510, 395) -->
          <g id="source-cable-gland" transform="translate(190, -85)">
            <rect x="-8" y="-14" width="16" height="28" rx="4" fill="#334155" stroke="#1e293b" stroke-width="1.5" />
            <rect x="2" y="-10" width="12" height="20" rx="3" fill="#475569" stroke="#1e293b" stroke-width="1.5" />
            <circle cx="10" cy="0" r="7" fill="#1e293b" />
          </g>
        </g>

        <!-- SOURCE LABELS (Floating Above Source) -->
        <g id="source-labels-group" class="interactive-label-group" transform="translate(400, 245)">
          <text x="0" y="0" text-anchor="middle" font-family="'Space Grotesk', sans-serif" font-size="14" font-weight="800" letter-spacing="0.12em" fill="#64748b" class="scene-label-caption">SOURCE</text>
          <text id="source-voltage-label" x="0" y="32" text-anchor="middle" font-family="'Space Grotesk', sans-serif" font-size="28" font-weight="800" fill="#2563eb" class="scene-label-value">230 V</text>
        </g>

        <!-- HEAVY ELECTRICAL CABLE RUN -->
        <!-- Starts seamlessly inside source gland at (510, 395), ends inside house weatherhead socket at (1032, 428) -->
        <g id="cable-system">
          <!-- Cable Outer Insulation / Shadow -->
          <path
            id="cable-outer-path"
            d="M510 395 C 660 480, 880 490, 1032 428"
            fill="none"
            stroke="#0f172a"
            stroke-width="26"
            stroke-linecap="round"
            class="cable-outer"
          />
          <!-- Cable Inner Body / Armor -->
          <path
            id="cable-core-path"
            d="M510 395 C 660 480, 880 490, 1032 428"
            fill="none"
            stroke="#1e293b"
            stroke-width="20"
            stroke-linecap="round"
            class="cable-core"
          />
          <!-- Cable Sheath Highlight -->
          <path
            id="cable-highlight-path"
            d="M510 392 C 660 477, 880 487, 1032 425"
            fill="none"
            stroke="#475569"
            stroke-width="4"
            stroke-linecap="round"
            opacity="0.4"
          />
          <!-- Conductor Thermal Overheat Glow (Active during high power dissipation / excessive drop) -->
          <path
            id="cable-thermal-path"
            d="M510 395 C 660 480, 880 490, 1032 428"
            fill="none"
            stroke="#ea580c"
            stroke-width="12"
            stroke-linecap="round"
            opacity="0"
            filter="url(#glowThermal)"
            class="cable-thermal"
          />
          <!-- Cable Electrical Field Glow Line -->
          <path
            id="cable-glow-path"
            d="M510 395 C 660 480, 880 490, 1032 428"
            fill="none"
            stroke="#22c55e"
            stroke-width="6"
            stroke-linecap="round"
            opacity="0.65"
            filter="url(#glowGreen)"
            class="cable-glow"
          />

          <!-- ANIMATED ELECTRICITY FLOW PARTICLES -->
          <!-- 16 energy particles moving sequentially along the catenary path -->
          <g id="cable-particles" class="cable-particles-group">
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="0s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="0.15s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="0.30s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="0.45s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="0.60s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="0.75s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="0.90s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="1.05s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="1.20s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="1.35s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="1.50s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="1.65s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="1.80s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="1.95s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="2.10s" />
            </circle>
            <circle r="4.5" fill="#d9f99d" class="flow-particle" filter="url(#glowGreen)">
              <animateMotion path="M510 395 C 660 480, 880 490, 1032 428" dur="2.4s" repeatCount="indefinite" begin="2.25s" />
            </circle>
          </g>
        </g>

        <!-- FLOATING VOLTAGE DROP CALLOUT BADGE (MID-SPAN) -->
        <g id="drop-callout-wrap" transform="translate(771, 370)">
          <!-- Pointer Guide Line down to catenary curve mid-point -->
          <line id="drop-pointer-line" x1="0" y1="28" x2="0" y2="115" stroke="#3b82f6" stroke-width="1.8" stroke-dasharray="3 3" opacity="0.75" />
          <circle id="drop-pointer-dot" cx="0" cy="115" r="3.5" fill="#3b82f6" />

          <!-- Callout Card Background -->
          <rect x="-95" y="-30" width="190" height="58" rx="12" fill="var(--surface-glass, #ffffff)" stroke="var(--border, #e2e8f0)" stroke-width="1.5" class="callout-card-bg" />

          <!-- Value row -->
          <g transform="translate(0, -6)">
            <!-- Down arrow icon -->
            <path d="M-65 -4 L-65 6 M-69 2 L-65 6 L-61 2" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" id="drop-callout-icon" />
            <text id="drop-callout-text" x="0" y="3" text-anchor="middle" font-family="'Space Grotesk', sans-serif" font-size="16" font-weight="800" fill="var(--text, #0f172a)">6.33 V (2.75%)</text>
          </g>
          <text x="0" y="16" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="11.5" font-weight="600" fill="var(--text-mid, #64748b)">voltage drop</text>
        </g>

        <!-- LOAD HOUSE & SURROUNDINGS (RIGHT) -->
        <!-- Placed at x=980, y=310. House left wall is at x=60 inside group -> Global Canvas X 1040 -->
        <g id="load-structure" transform="translate(980, 310)">
          <!-- Ground Shadow -->
          <ellipse cx="200" cy="340" rx="190" ry="26" fill="#1b4d29" opacity="0.4" />

          <!-- Chimney -->
          <rect x="250" y="0" width="34" height="68" fill="#475569" stroke="#334155" stroke-width="2" rx="2" />
          <rect x="245" y="-6" width="44" height="10" fill="#334155" rx="2" />

          <!-- Animated Chimney Smoke -->
          <g class="smoke-group" aria-hidden="true">
            <circle cx="267" cy="-20" r="8" fill="#ffffff" opacity="0.25" class="smoke" style="animation-delay: 0s;" />
