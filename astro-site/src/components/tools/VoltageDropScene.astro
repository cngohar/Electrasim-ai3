<style>
  .scene-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #e0f2fe;
    transition: background 0.4s ease;
  }
  :global(:root[data-theme="dark"]) .scene-container {
    background: #0b1526;
  }
  .scene-scaler {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 1440px;
    height: 810px;
    transform-origin: center center;
  }
  .scene-perspective-wrapper {
    width: 100%;
    height: 100%;
    transition: transform 0.25s ease-out;
    transform-style: preserve-3d;
  }
  .scene-svg {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
  }

  /* SVG Scenery Animations */
  @keyframes cloudDrift {
    0% {
      transform: translateX(-300px);
    }
    100% {
      transform: translateX(1700px);
    }
  }
  .cloud {
    animation: cloudDrift linear infinite;
  }

  @keyframes birdGlide {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(60px, -15px);
    }
    100% {
      transform: translate(120px, 0);
    }
  }
  .bird {
    animation: birdGlide 4.5s ease-in-out infinite;
  }

  /* 
   * TREE SWAY - ANCHORED BASE
   * transform-box: fill-box and transform-origin: 50% 100% guarantees
   * trees rotate strictly around their rooted trunk base, NEVER jumping off ground!
   */
  @keyframes treeSway {
    0%, 100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.8deg);
    }
  }
  .tree {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: treeSway 5.5s ease-in-out infinite;
  }

  @keyframes smokeRise {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.6);
    }
    40% {
      opacity: 0.35;
    }
    100% {
      opacity: 0;
      transform: translate(18px, -55px) scale(1.8);
    }
  }
  .smoke {
    animation: smokeRise 3.5s ease-out infinite;
  }

  @keyframes ledBlink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .led-blink {
    animation: ledBlink 1.4s ease-in-out infinite;
  }

  @keyframes winFlicker {
    0%, 100% {
      opacity: 0.95;
    }
    45% {
      opacity: 0.75;
    }
    75% {
      opacity: 0.9;
    }
  }
  .win-flicker {
    animation: winFlicker 6s ease-in-out infinite;
  }

  @keyframes starTwinkle {
    0%, 100% {
      opacity: 0.3;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }
  .star {
    transform-box: fill-box;
    transform-origin: center;
    animation: starTwinkle 3s ease-in-out infinite;
  }

  /* Thermal Glow Animation */
  @keyframes thermalPulse {
    0%, 100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.9;
    }
  }
  .cable-thermal.active {
    animation: thermalPulse 2s ease-in-out infinite;
  }

  /* Night Mode Theme Overrides */
  :global(:root[data-theme="dark"]) .sky-stop-0 {
    stop-color: #07142f;
  }
  :global(:root[data-theme="dark"]) .sky-stop-52 {
    stop-color: #17345c;
  }
  :global(:root[data-theme="dark"]) .sky-stop-100 {
    stop-color: #4c6380;
  }
  :global(:root[data-theme="dark"]) .sun-stop-0 {
    stop-color: #cbd5ff;
    stop-opacity: 0.35;
  }
  :global(:root[data-theme="dark"]) .sun-stop-50 {
    stop-color: #91a6e8;
    stop-opacity: 0.12;
  }
  :global(:root[data-theme="dark"]) .mt-far-0 {
    stop-color: #263b5a;
  }
  :global(:root[data-theme="dark"]) .mt-far-100 {
    stop-color: #435974;
  }
  :global(:root[data-theme="dark"]) .mt-near-0 {
    stop-color: #1e3344;
  }
  :global(:root[data-theme="dark"]) .mt-near-100 {
    stop-color: #384f58;
  }
  :global(:root[data-theme="dark"]) .horizon-stop {
    stop-color: #1e293b;
    stop-opacity: 0.4;
  }
  :global(:root[data-theme="dark"]) .stars-group {
    opacity: 1;
  }
  :global(:root:not([data-theme="dark"])) .stars-group {
    opacity: 0;
  }
  :global(:root[data-theme="dark"]) .house-wall {
    fill: #334155;
    stroke: #475569;
  }

  /* Paused Scene */
  .scene-paused .cloud,
  .scene-paused .bird,
  .scene-paused .tree,
  .scene-paused .smoke,
  .scene-paused .led-blink,
  .scene-paused .win-flicker,
  .scene-paused .star,
  .scene-paused .cable-thermal {
    animation-play-state: paused !important;
  }
</style>
