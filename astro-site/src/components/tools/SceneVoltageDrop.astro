---
/**
 * Voltage-drop scene: source → cable → load (master plan §16).
 *
 * Pure inline SVG + CSS keyframes. No 3D library, no canvas — the mockup only
 * *looks* dimensional (§34). Labels are real <text>, so they are crawlable and
 * selectable rather than rasterised.
 */
---

<div class="scene-region">
  <div class="drop-callout" data-callout aria-hidden="true">
    <p class="drop-callout-main">
      <span data-callout-drop>6.90 V</span>
      <span data-callout-pct>(3.00%)</span>
    </p>
    <p class="drop-callout-sub">voltage drop</p>
  </div>

  <svg
    class="scene-svg"
    data-scene
    viewBox="0 0 1440 810"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-labelledby="scene-title scene-desc"
  >
    <title id="scene-title">Voltage drop along a cable run</title>
    <desc id="scene-desc" data-scene-desc>
      A supply source connected by a cable to a house, showing the voltage at each end.
    </desc>

    <defs>
      <linearGradient id="vdSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#bfe3ff" /><stop offset="55%" stop-color="#dcefff" />
        <stop offset="100%" stop-color="#eef8ff" />
      </linearGradient>
      <linearGradient id="vdHillHaze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#cfe4d8" /><stop offset="100%" stop-color="#b6d6bd" />
      </linearGradient>
      <linearGradient id="vdHillFar" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#b4d5b0" /><stop offset="100%" stop-color="#86c184" />
      </linearGradient>
      <linearGradient id="vdHillNear" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#8ccb84" /><stop offset="100%" stop-color="#5faa61" />
      </linearGradient>
      <linearGradient id="vdGround" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#79bd72" /><stop offset="100%" stop-color="#4b9752" />
      </linearGradient>
      <linearGradient id="vdBox" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#eef1f5" /><stop offset="55%" stop-color="#c6cfd9" />
        <stop offset="100%" stop-color="#a3aebc" />
      </linearGradient>
      <linearGradient id="vdRoof" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#4a5568" /><stop offset="100%" stop-color="#2c3441" />
      </linearGradient>
    </defs>

    <rect width="1440" height="810" fill="url(#vdSky)" />

    <!-- sun with a soft halo -->
    <g aria-hidden="true">
      <circle cx="1210" cy="120" r="86" fill="#fff6cc" opacity=".35" />
      <circle cx="1210" cy="120" r="62" fill="#fff2b8" opacity=".5" />
      <circle class="vd-sun" cx="1210" cy="120" r="44" fill="#fff3bf" />
    </g>

    <g class="vd-stars" aria-hidden="true">
      <circle class="star d1" cx="200" cy="80" r="1.9" fill="#fff" />
      <circle class="star d2" cx="520" cy="52" r="1.6" fill="#fff" />
      <circle class="star d3" cx="900" cy="94" r="1.7" fill="#fff" />
      <circle class="star d4" cx="330" cy="146" r="1.4" fill="#fff" />
      <circle class="star d2" cx="1080" cy="60" r="1.5" fill="#fff" />
    </g>

    <!-- clouds at two depths -->
    <g aria-hidden="true">
      <g class="cloud cloud-far" fill="#ffffff" opacity=".55">
        <ellipse cx="480" cy="88" rx="46" ry="17" /><ellipse cx="512" cy="80" rx="32" ry="21" />
      </g>
      <g class="cloud" fill="#ffffff" opacity=".95">
        <ellipse cx="210" cy="132" rx="58" ry="25" /><ellipse cx="254" cy="121" rx="42" ry="30" />
        <ellipse cx="166" cy="126" rx="36" ry="21" />
      </g>
      <g class="cloud d4" fill="#ffffff" opacity=".9">
        <ellipse cx="720" cy="96" rx="48" ry="20" /><ellipse cx="756" cy="88" rx="34" ry="24" />
        <ellipse cx="688" cy="92" rx="28" ry="16" />
      </g>
    </g>

    <!-- a small flock -->
    <g stroke="#64748b" stroke-width="2.2" fill="none" stroke-linecap="round" aria-hidden="true">
      <g class="bird"><path d="M360 178c7-7 14-7 21 0M381 178c7-7 14-7 21 0" /></g>
      <g class="bird d1" opacity=".75"><path d="M430 208c5-5 10-5 15 0M445 208c5-5 10-5 15 0" /></g>
      <g class="bird d2" opacity=".55"><path d="M300 226c4-4 8-4 12 0M312 226c4-4 8-4 12 0" /></g>
    </g>

    <!-- landscape: three hill bands with aerial perspective -->
    <path d="M0 430c150-40 250 8 380-14s230-46 380-24 250 18 400-4 190 6 280-2v426H0z" fill="url(#vdHillHaze)" />
    <path d="M0 452c170-52 300 14 460-16s280-66 480-30 290 18 500-8v412H0z" fill="url(#vdHillFar)" />
    <path d="M0 520c200-44 340 26 520-8s320-52 520-14 260 22 400 8v304H0z" fill="url(#vdHillNear)" />
    <rect y="596" width="1440" height="214" fill="url(#vdGround)" />

    <!-- footpath -->
    <path d="M600 810c70-108 176-140 224-176l70 5c-48 52-142 88-190 171z" fill="#dccfb2" opacity=".9" />
    <path d="M640 810c60-92 150-122 196-152" stroke="#cbbd9c" stroke-width="3" fill="none" opacity=".5" />

    <!-- distant transmission line: thematic depth cue -->
    <g stroke="#8fa3b8" stroke-width="2.4" fill="none" opacity=".45" aria-hidden="true">
      <path d="M120 470v-74M104 404h32M108 416h24" />
      <path d="M226 476v-64M212 418h28M216 428h20" />
      <path d="M120 398c36 10 70 14 106 16" />
    </g>

    <!-- trees: varied greens, front row larger -->
    <g aria-hidden="true">
      <g class="tree"><ellipse cx="96" cy="500" rx="24" ry="29" fill="#4d9a52" /><ellipse cx="88" cy="492" rx="14" ry="17" fill="#59a95d" /><rect x="91" y="522" width="8" height="26" fill="#7c5c3a" /></g>
      <g class="tree d1"><ellipse cx="250" cy="486" rx="19" ry="23" fill="#3f8c48" /><rect x="246" y="504" width="7" height="20" fill="#7c5c3a" /></g>
      <g class="tree d3"><ellipse cx="176" cy="512" rx="16" ry="19" fill="#5cae5f" /><rect x="173" y="527" width="6" height="17" fill="#7c5c3a" /></g>
      <g class="tree d2"><ellipse cx="1352" cy="504" rx="26" ry="31" fill="#458f4c" /><ellipse cx="1344" cy="495" rx="15" ry="18" fill="#51a055" /><rect x="1347" y="528" width="8" height="28" fill="#7c5c3a" /></g>
      <g class="tree d3"><ellipse cx="1420" cy="484" rx="19" ry="22" fill="#3f8c48" /><rect x="1416" y="502" width="7" height="20" fill="#7c5c3a" /></g>
      <g class="tree d1"><ellipse cx="836" cy="500" rx="17" ry="20" fill="#4a9a50" /><rect x="833" y="516" width="6" height="18" fill="#7c5c3a" /></g>
    </g>

    <!-- shrubs + wildflowers -->
    <g aria-hidden="true">
      <ellipse cx="1310" cy="614" rx="34" ry="18" fill="#4f9e56" />
      <ellipse cx="1288" cy="620" rx="22" ry="13" fill="#5cae5f" />
      <ellipse cx="322" cy="640" rx="30" ry="15" fill="#4f9e56" />
      <g fill="#fef3c7"><circle cx="196" cy="676" r="3.5" /><circle cx="236" cy="700" r="3" /><circle cx="1108" cy="686" r="3.2" /></g>
      <g fill="#fbcfe8"><circle cx="164" cy="704" r="3.2" /><circle cx="1176" cy="712" r="3" /></g>
      <g stroke="#3f8c48" stroke-width="2.4" stroke-linecap="round" opacity=".8">
        <path d="M150 742c4-14 6-20 4-30M162 744c0-12 3-19 8-27M1246 738c3-13 5-19 3-28M1258 740c0-11 3-18 7-25" />
      </g>
    </g>

    <!-- contact shadows -->
    <ellipse cx="400" cy="676" rx="86" ry="14" fill="#2f5d33" opacity=".18" aria-hidden="true" />
    <ellipse cx="1158" cy="552" rx="150" ry="18" fill="#2f5d33" opacity=".16" aria-hidden="true" />

    <!-- ── SOURCE: supply cabinet. Cable leaves the gland at (466,400). ── -->
    <g data-source>
      <rect x="374" y="596" width="56" height="74" rx="4" fill="#98a3af" />
      <rect x="356" y="656" width="92" height="18" rx="4" fill="#8b96a3" />
      <rect x="330" y="252" width="140" height="216" rx="11" fill="url(#vdBox)" stroke="#8f9aa8" stroke-width="2" />
      <rect x="345" y="267" width="110" height="186" rx="7" fill="none" stroke="#bcc6d2" stroke-width="2" />
      <rect x="352" y="462" width="96" height="140" fill="#aab4c0" />
      <circle class="led-blink" data-source-led cx="364" cy="284" r="6.5" fill="#22c55e" />
      <path d="M404 300l-19 30h17l-4 25 22-33h-17z" fill="#f5c518" stroke="#8a6d00" stroke-width="1.8" stroke-linejoin="round" />
      <rect x="386" y="372" width="30" height="36" rx="5" fill="#3f4652" />
      <circle cx="401" cy="384" r="5.5" fill="#ef4444" />
      <rect x="452" y="384" width="26" height="30" rx="6" fill="#8f9aa8" />
      <g stroke="#9aa5b2" stroke-width="3" stroke-linecap="round" opacity=".9" aria-hidden="true">
        <path d="M356 424h34M356 434h34M356 444h34" />
      </g>
      <g fill="#7e8996" aria-hidden="true">
        <rect x="330" y="286" width="5" height="18" rx="2" /><rect x="330" y="416" width="5" height="18" rx="2" />
      </g>
      <text x="400" y="212" text-anchor="middle" class="vd-cap">SOURCE</text>
      <text x="400" y="246" text-anchor="middle" class="vd-val vd-val-source" data-source-voltage>230.00 V</text>
    </g>

    <!-- ── CABLE: the reference path, verbatim ────────────────────────── -->
    <g data-cable-group>
      <path d="M466 400 C 645 478, 850 490, 1000 434" fill="none" stroke="#2c333d" stroke-width="20" stroke-linecap="round" />
      <path d="M466 400 C 645 478, 850 490, 1000 434" fill="none" stroke="#48525e" stroke-width="13" stroke-linecap="round" />
      <path class="vd-flow" data-cable-flow d="M466 400 C 645 478, 850 490, 1000 434" fill="none" stroke="#22c55e" stroke-width="8" stroke-linecap="round" />
    </g>

    <!-- ── LOAD: house, fed at (1000,434) ─────────────────────────────── -->
    <g data-load>
      <rect x="996" y="418" width="28" height="24" rx="6" fill="#8f9aa8" />
      <g class="smoke" aria-hidden="true"><circle cx="1214" cy="290" r="10" fill="#ffffff" opacity=".5" /></g>
      <rect x="1200" y="290" width="28" height="52" fill="#5b6472" />
      <path d="M1010 372l148-96 148 96z" fill="url(#vdRoof)" />
      <rect x="1032" y="368" width="252" height="180" rx="6" fill="#f6f3ec" stroke="#ddd6ca" stroke-width="2" />
      <rect x="1136" y="452" width="48" height="96" rx="4" fill="#3b3730" />
      <circle cx="1174" cy="502" r="4" fill="#e9c46a" />
      <rect class="win-flicker" data-window x="1062" y="404" width="56" height="48" rx="4" fill="#ffd88a" stroke="#c9a24a" stroke-width="2" />
      <rect class="win-flicker" data-window x="1200" y="404" width="56" height="48" rx="4" fill="#ffd88a" stroke="#c9a24a" stroke-width="2" />
      <path d="M1090 404v48M1062 428h56M1228 404v48M1200 428h56" stroke="#c9a24a" stroke-width="2" />
      <rect x="1022" y="366" width="272" height="9" rx="4" fill="#59606d" aria-hidden="true" />
      <path d="M1010 372h296" stroke="#3b4453" stroke-width="3" aria-hidden="true" />
      <rect x="1120" y="544" width="80" height="10" rx="3" fill="#d8d2c6" aria-hidden="true" />
      <rect x="1112" y="552" width="96" height="10" rx="3" fill="#c9c2b4" aria-hidden="true" />
      <g aria-hidden="true">
        <ellipse cx="1054" cy="548" rx="26" ry="12" fill="#4f9e56" />
        <ellipse cx="1272" cy="548" rx="24" ry="11" fill="#57a75c" />
      </g>
      <text x="1040" y="212" text-anchor="middle" class="vd-cap">LOAD</text>
      <text x="1040" y="246" text-anchor="middle" class="vd-val vd-val-load" data-load-voltage>223.10 V</text>
    </g>
  </svg>
</div>

<style>
  .vd-cap {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.06em;
    fill: #0f172a;
  }
  .vd-val {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 700;
  }
  .vd-val-source { fill: #2563eb; }
  .vd-val-load { fill: #16a34a; }


  /* Moving dots = current. One animated property, compositor friendly. */
  .vd-flow {
    stroke-dasharray: 3 17;
    animation: vdFlow 0.9s linear infinite;
  }
  @keyframes vdFlow {
    to { stroke-dashoffset: -20; }
  }

  @keyframes cloudDrift { from { transform: translateX(-480px); } to { transform: translateX(1920px); } }
  .cloud { animation: cloudDrift 120s linear infinite; }
  @keyframes birdGlide { 0%, 100% { transform: translateY(0) scaleX(1); } 50% { transform: translateY(-3px) scaleX(.92); } }
  .bird { transform-box: fill-box; transform-origin: 50%; animation: birdGlide 3.8s ease-in-out infinite; }
  @keyframes treeSway { from { transform: rotate(-1.3deg); } to { transform: rotate(1.3deg); } }
  .tree { transform-box: fill-box; transform-origin: 50% 100%; animation: treeSway 5s ease-in-out infinite alternate; }
  @keyframes smokeRise { 0% { opacity: 0; transform: translate(0,0) scale(.5); } 12% { opacity: .55; } 100% { opacity: 0; transform: translate(-16px,-54px) scale(1.7); } }
  .smoke { transform-box: fill-box; transform-origin: 50%; animation: smokeRise 3.4s ease-out infinite; }
  @keyframes ledBlink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
  .led-blink { animation: ledBlink 2.2s ease-in-out infinite; }
  @keyframes winFlicker { 0%, 100% { opacity: .82; } 50% { opacity: 1; } }
  .win-flicker { animation: winFlicker 3.8s ease-in-out infinite; }
  @keyframes twinkle { 0%, 100% { opacity: .12; } 50% { opacity: .9; } }
  .star { animation: twinkle 3s ease-in-out infinite; }
  .vd-stars { opacity: 0; transition: opacity .8s ease; }


  /* Paused when the tool is off-screen or the user asked for stillness. */
  .scene-paused .cloud,
  .scene-paused .bird,
  .scene-paused .tree,
  .scene-paused .smoke,
  .scene-paused .led-blink,
  .scene-paused .win-flicker,
  .scene-paused .star,
  .scene-paused .vd-flow {
    animation-play-state: paused;
  }
  .cloud-far { animation-duration: 190s; }

  /* §20 — keep every value, drop the motion. */
  @media (prefers-reduced-motion: reduce) {
    .cloud, .bird, .tree, .smoke, .led-blink, .win-flicker, .star, .vd-flow {
      animation: none !important;
    }
    .vd-flow { stroke-dasharray: 3 17; }
  }
  .d1 { animation-delay: -1.1s; }
  .d2 { animation-delay: -2.2s; }
  .d3 { animation-delay: -3.3s; }
  .d4 { animation-delay: -52s; }
  [data-window]:nth-of-type(2) { animation-delay: -1.6s; }
</style>
