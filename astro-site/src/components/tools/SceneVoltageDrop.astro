---
/**
 * Voltage-drop scene: source → cable → load (master plan §16).
 *
 * Pure inline SVG + CSS keyframes. No 3D library, no canvas — the mockup only
 * *looks* dimensional (§34). Labels are real <text>, so they are crawlable and
 * selectable rather than rasterised.
 */
---

<div class="scene-region">
  <div class="drop-callout" data-callout aria-hidden="true">
    <p class="drop-callout-main">
      <span data-callout-drop>6.90 V</span>
      <span data-callout-pct>(3.00%)</span>
    </p>
    <p class="drop-callout-sub">voltage drop</p>
  </div>
  <svg
    class="scene-svg"
    data-scene
    viewBox="0 0 1330 620"
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-labelledby="scene-title scene-desc"
  >
    <title id="scene-title">Voltage drop along a cable run</title>
    <desc id="scene-desc" data-scene-desc>
      A supply source connected by a cable to a house, showing the voltage at each end.
    </desc>

    <defs>
      <linearGradient id="vdSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#bfe3ff" /><stop offset="55%" stop-color="#dcefff" />
        <stop offset="100%" stop-color="#eef8ff" />
      </linearGradient>
      <linearGradient id="vdHillFar" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#9fd39a" /><stop offset="100%" stop-color="#7cbf7d" />
      </linearGradient>
      <linearGradient id="vdHillNear" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#8ccb84" /><stop offset="100%" stop-color="#5faa61" />
      </linearGradient>
      <linearGradient id="vdGround" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#79bd72" /><stop offset="100%" stop-color="#4e9a55" />
      </linearGradient>
      <linearGradient id="vdBox" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e8ecf1" /><stop offset="55%" stop-color="#c3ccd6" />
        <stop offset="100%" stop-color="#a7b2bf" />
      </linearGradient>
      <linearGradient id="vdRoof" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#4a5568" /><stop offset="100%" stop-color="#2d3748" />
      </linearGradient>
    </defs>

    <!-- sky + weather -->
    <rect width="1330" height="620" fill="url(#vdSky)" />
    <circle class="vd-sun" cx="1040" cy="96" r="42" fill="#fff3bf" opacity=".85" />
    <g class="vd-stars" aria-hidden="true">
      <circle class="star d1" cx="180" cy="70" r="1.8" fill="#fff" />
      <circle class="star d2" cx="420" cy="46" r="1.5" fill="#fff" />
      <circle class="star d3" cx="760" cy="82" r="1.6" fill="#fff" />
    </g>
    <g fill="#ffffff" opacity=".9" aria-hidden="true">
      <g class="cloud">
        <ellipse cx="180" cy="110" rx="54" ry="24" /><ellipse cx="220" cy="100" rx="40" ry="28" />
        <ellipse cx="140" cy="104" rx="34" ry="20" />
      </g>
      <g class="cloud d4">
        <ellipse cx="620" cy="80" rx="44" ry="19" /><ellipse cx="652" cy="72" rx="32" ry="22" />
      </g>
    </g>
    <g class="bird" stroke="#64748b" stroke-width="2" fill="none" stroke-linecap="round" aria-hidden="true">
      <path d="M300 150c6-6 12-6 18 0M318 150c6-6 12-6 18 0" />
    </g>

    <!-- hills -->
    <path d="M0 360c150-46 260 12 400-14s250-58 420-26 260 16 510-6v306H0z" fill="url(#vdHillFar)" />
    <path d="M0 420c180-40 300 22 460-6s280-46 460-12 220 18 410 6v212H0z" fill="url(#vdHillNear)" />
    <rect y="470" width="1330" height="150" fill="url(#vdGround)" />
    <path d="M470 620c60-92 150-118 190-150l60 4c-40 44-120 74-160 146z" fill="#d9cdb0" opacity=".85" />

    <!-- distant trees -->
    <g aria-hidden="true">
      <g class="tree"><ellipse cx="90" cy="404" rx="22" ry="26" fill="#4d9a52" /><rect x="86" y="424" width="7" height="22" fill="#7c5c3a" /></g>
      <g class="tree d1"><ellipse cx="250" cy="392" rx="18" ry="21" fill="#3f8c48" /><rect x="247" y="408" width="6" height="18" fill="#7c5c3a" /></g>
      <g class="tree d2"><ellipse cx="980" cy="398" rx="20" ry="23" fill="#458f4c" /><rect x="977" y="416" width="6" height="20" fill="#7c5c3a" /></g>
      <g class="tree d3"><ellipse cx="1120" cy="386" rx="17" ry="20" fill="#3f8c48" /><rect x="1117" y="402" width="6" height="18" fill="#7c5c3a" /></g>
    </g>

    <!-- ── SOURCE: supply cabinet ─────────────────────────────────────── -->
    <g data-source>
      <rect x="392" y="530" width="54" height="56" rx="4" fill="#9aa5b1" />
      <rect x="380" y="574" width="80" height="16" rx="4" fill="#8b96a3" />
      <rect x="360" y="330" width="128" height="150" rx="10" fill="url(#vdBox)" stroke="#8f9aa8" stroke-width="2" />
      <rect x="374" y="344" width="100" height="122" rx="6" fill="none" stroke="#b9c3cf" stroke-width="2" />
      <rect x="378" y="470" width="92" height="70" fill="#aab4c0" />
      <circle class="led-blink" data-source-led cx="392" cy="360" r="6" fill="#22c55e" />
      <path d="M424 372l-16 24h14l-3 20 18-26h-14z" fill="#f5c518" stroke="#8a6d00" stroke-width="1.6" stroke-linejoin="round" />
      <rect x="404" y="424" width="26" height="30" rx="4" fill="#3f4652" />
      <circle cx="417" cy="434" r="5" fill="#ef4444" />
      <text x="424" y="300" text-anchor="middle" class="vd-cap">SOURCE</text>
      <text x="424" y="322" text-anchor="middle" class="vd-val vd-val-source" data-source-voltage>230 V</text>
      <rect x="484" y="392" width="22" height="26" rx="5" fill="#8f9aa8" />
    </g>

    <!-- ── CABLE ──────────────────────────────────────────────────────── -->
    <g data-cable-group>
      <path
        d="M504 405 C 596 462, 682 462, 762 430"
        fill="none" stroke="#2f3742" stroke-width="17" stroke-linecap="round"
      />
      <path
        d="M504 405 C 596 462, 682 462, 762 430"
        fill="none" stroke="#4a5560" stroke-width="11" stroke-linecap="round"
      />
      <path
        class="vd-flow" data-cable-flow
        d="M504 405 C 596 462, 682 462, 762 430"
        fill="none" stroke="#22c55e" stroke-width="7" stroke-linecap="round"
      />
    </g>

    <!-- ── LOAD: house ────────────────────────────────────────────────── -->
    <g data-load transform="translate(-96,0)">
      <rect x="852" y="410" width="26" height="20" rx="5" fill="#8f9aa8" />
      <g class="smoke" aria-hidden="true"><circle cx="1006" cy="300" r="9" fill="#ffffff" opacity=".5" /></g>
      <rect x="994" y="300" width="26" height="46" fill="#5b6472" />
      <path d="M864 372l130-84 130 84z" fill="url(#vdRoof)" />
      <rect x="889" y="368" width="210" height="150" rx="6" fill="#f4f1ea" stroke="#ddd6ca" stroke-width="2" />
      <rect x="974" y="440" width="42" height="78" rx="4" fill="#3b3730" />
      <circle cx="1010" cy="482" r="3.5" fill="#e9c46a" />
      <rect class="win-flicker" data-window x="909" y="404" width="50" height="46" rx="4" fill="#ffd88a" stroke="#c9a24a" stroke-width="2" />
      <rect class="win-flicker" data-window x="1032" y="404" width="50" height="46" rx="4" fill="#ffd88a" stroke="#c9a24a" stroke-width="2"  />
      <path d="M934 404v46M909 427h50M1057 404v46M1032 427h50" stroke="#c9a24a" stroke-width="2" />
      <text x="994" y="238" text-anchor="middle" class="vd-cap">LOAD</text>
      <text x="994" y="260" text-anchor="middle" class="vd-val vd-val-load" data-load-voltage>223.10 V</text>
    </g>
  </svg>
</div>

<style>
  .vd-cap {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.06em;
    fill: #0f172a;
  }
  .vd-val {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
  }
  .vd-val-source { fill: #2563eb; }
  .vd-val-load { fill: #16a34a; }
  [data-theme='dark'] .vd-cap { fill: #e8edf6; }

  /* Moving dots = current. One animated property, compositor friendly. */
  .vd-flow {
    stroke-dasharray: 3 17;
    animation: vdFlow 0.9s linear infinite;
  }
  @keyframes vdFlow {
    to { stroke-dashoffset: -20; }
  }

  @keyframes cloudDrift { from { transform: translateX(-480px); } to { transform: translateX(1920px); } }
  .cloud { animation: cloudDrift 120s linear infinite; }
  @keyframes birdGlide { 0%, 100% { transform: translateY(0) scaleX(1); } 50% { transform: translateY(-3px) scaleX(.92); } }
  .bird { transform-box: fill-box; transform-origin: 50%; animation: birdGlide 3.8s ease-in-out infinite; }
  @keyframes treeSway { from { transform: rotate(-1.3deg); } to { transform: rotate(1.3deg); } }
  .tree { transform-box: fill-box; transform-origin: 50% 100%; animation: treeSway 5s ease-in-out infinite alternate; }
  @keyframes smokeRise { 0% { opacity: 0; transform: translate(0,0) scale(.5); } 12% { opacity: .55; } 100% { opacity: 0; transform: translate(-16px,-54px) scale(1.7); } }
  .smoke { transform-box: fill-box; transform-origin: 50%; animation: smokeRise 3.4s ease-out infinite; }
  @keyframes ledBlink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }
  .led-blink { animation: ledBlink 2.2s ease-in-out infinite; }
  @keyframes winFlicker { 0%, 100% { opacity: .82; } 50% { opacity: 1; } }
  .win-flicker { animation: winFlicker 3.8s ease-in-out infinite; }
  @keyframes twinkle { 0%, 100% { opacity: .12; } 50% { opacity: .9; } }
  .star { animation: twinkle 3s ease-in-out infinite; }
  .vd-stars { opacity: 0; }

  /* Paused when the tool is off-screen or the user asked for stillness. */
  .scene-paused .cloud,
  .scene-paused .bird,
  .scene-paused .tree,
  .scene-paused .smoke,
  .scene-paused .led-blink,
  .scene-paused .win-flicker,
  .scene-paused .star,
  .scene-paused .vd-flow {
    animation-play-state: paused;
  }

  /* §20 — keep every value, drop the motion. */
  @media (prefers-reduced-motion: reduce) {
    .cloud, .bird, .tree, .smoke, .led-blink, .win-flicker, .star, .vd-flow {
      animation: none !important;
    }
    .vd-flow { stroke-dasharray: 3 17; }
  }
  .d1 { animation-delay: -1.1s; }
  .d2 { animation-delay: -2.2s; }
  .d3 { animation-delay: -3.3s; }
  .d4 { animation-delay: -52s; }
  [data-window]:nth-of-type(2) { animation-delay: -1.6s; }
</style>
