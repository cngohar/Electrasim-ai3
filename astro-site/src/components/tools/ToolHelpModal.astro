<div id="tool-help-backdrop" class="tool-help-backdrop" hidden>
  <div
    id="tool-help-dialog"
    class="tool-help-dialog nice-scroll"
    role="dialog"
    aria-modal="true"
    aria-labelledby="help-modal-title"
  >
    <div class="help-modal-header">
      <div class="help-modal-title-wrap">
        <span class="help-icon-bolt">⚡</span>
        <h2 id="help-modal-title" class="help-modal-title">How Voltage Drop Works</h2>
      </div>
      <button type="button" id="tool-help-close" class="btn-help-close" aria-label="Close help modal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="help-modal-body">
      <!-- Formulas Box -->
      <div class="help-formulas-box">
        <div class="formula-row">
          <span class="formula-label">DC:</span>
          <code>V<sub>drop</sub> = 2 · I · L · r</code>
        </div>
        <div class="formula-row">
          <span class="formula-label">1-Φ AC:</span>
          <code>V<sub>drop</sub> = 2 · I · L · (r cos φ + x sin φ)</code>
        </div>
        <div class="formula-row">
          <span class="formula-label">3-Φ AC:</span>
          <code>V<sub>drop</sub> = √3 · I · L · (r cos φ + x sin φ)</code>
        </div>
        <div class="formula-divider"></div>
        <div class="formula-meta">
          <span>r = ρ<sub>T</sub> / A (Ω/m one-way conductor resistance)</span>
          <span>P<sub>loss</sub> = I² · R<sub>total</sub> (Watts wasted as heat)</span>
        </div>
      </div>

      <!-- Materials Cards -->
      <div class="help-materials-grid">
        <div class="material-card copper">
          <div class="mat-badge">COPPER</div>
          <div class="mat-rho">0.0172 <span class="mat-unit">Ω·mm²/m</span></div>
          <div class="mat-temp">at 20 °C (Standard electrolytic)</div>
        </div>
        <div class="material-card aluminum">
          <div class="mat-badge">ALUMINUM</div>
          <div class="mat-rho">0.0282 <span class="mat-unit">Ω·mm²/m</span></div>
          <div class="mat-temp">at 20 °C (~64% higher resistance)</div>
        </div>
      </div>

      <!-- Status Guidelines -->
      <div class="help-guidelines">
        <h3 class="guidelines-title">BS 7671 & International Guidelines</h3>
        <ul class="guidelines-list">
          <li>
            <strong class="tag-good">≤ 3%</strong>
            <span><strong>Good:</strong> Complies with the strict 3% limit for lighting circuits to prevent visible flicker.</span>
          </li>
          <li>
            <strong class="tag-warning">&gt; 3% – 5%</strong>
            <span><strong>Marginal:</strong> Acceptable under BS 7671 for power sockets, heaters, and appliances from a public supply.</span>
          </li>
          <li>
            <strong class="tag-excessive">&gt; 5%</strong>
            <span><strong>Excessive:</strong> Drop exceeds recommended design standards. Upsize cable cross-section or shorten length to avoid overheating.</span>
          </li>
        </ul>
      </div>

      <div class="help-tip-note">
        <span class="tip-icon">💡</span>
        <span><strong>Pro Tip:</strong> Conductor resistance increases by ~0.4% per °C above 20 °C. Under full load, conductors often operate at 70 °C (PVC) or 90 °C (XLPE).</span>
      </div>
    </div>

    <div class="help-modal-footer">
      <button type="button" id="tool-help-confirm" class="btn-help-gotit">Got It</button>
    </div>
  </div>
</div>

