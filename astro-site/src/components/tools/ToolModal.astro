---
/**
 * Generic Toolbox dialog. Opened by any `[data-modal-open="<id>"]`, closed by
 * Escape, the scrim or its own close button. Focus is trapped and restored by
 * the shared overlay helper in workspace.ts.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<div class="tool-modal" data-modal={id} id={`modal-${id}`} hidden role="dialog" aria-modal="true" aria-labelledby={`modal-${id}-title`}>
  <div class="tool-modal-head">
    <h2 id={`modal-${id}-title`} class="tool-modal-title">{title}</h2>
    <button class="tool-icon-btn" type="button" data-modal-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="tool-modal-body">
    <slot />
  </div>
</div>
